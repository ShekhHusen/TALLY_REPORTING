;; ============================================================================
;;  JAY BAUDHIMAI TRADERS - WEB REPORTING & LIVE SYNC CONNECTOR
;;  TallyPrime TDL Module v2.2.0 (Portable Edition - Dual Path Support)
;;
;;  Features:
;;  1. Auto-Start Proxy & Auto-Connect when Tally starts up.
;;  2. In-Tally ON / OFF Toggle Switch from Gateway of Tally (Alt + W).
;;  3. Persistent configuration saved across Tally sessions.
;;  4. One-click F4 button to launch Web Portal directly in default browser.
;;  5. TDL Collection JBTWebSyncInfo for Web App bi-directional status sync.
;;  6. PORTABLE: Configure BOTH TDL Folder Path and Proxy Folder Path
;;     directly inside Tally settings. They can be anywhere on any drive!
;;
;;  SETUP: After loading TDL, press W on Gateway of Tally, enter the
;;         "TDL Folder Path" and "Proxy Folder Path", and press Ctrl+A to save.
;; ============================================================================

[#System: Formulae]
    JBTAddonName         : "Jay Baudhimai Web Sync"
    JBTAddonVersion      : "2.2.0"
    JBTDefaultProxyPort  : 3001
    JBTDefaultTallyPort  : 9000
    JBTDefaultPortalURL  : "http://localhost:3000"

    ;; Script paths built dynamically from user-configured ##JBTTDLFolderPath
    JBTLauncherScript    : ##JBTTDLFolderPath + "\\start-proxy-silent.vbs"
    JBTStopScript        : ##JBTTDLFolderPath + "\\stop-proxy.bat"

    ;; Launch command passes proxy folder path as argument to VBScript
    JBTLaunchCommand     : '"' + @@JBTLauncherScript + '" "' + ##JBTProxyFolderPath + '"'

    ;; Menu & Status display strings
    JBTMenuTitle         : If ##JBTWebSyncActive Then "Web Sync Connector [ON]" Else "Web Sync Connector [OFF]"
    JBTButtonTitle       : If ##JBTWebSyncActive Then "Web Sync: ON" Else "Web Sync: OFF"
    JBTSyncStatusText    : If ##JBTWebSyncActive Then "ENABLED (Active)" Else "DISABLED (Paused)"
    JBTCompanyText       : If $$IsEmpty:$$CurrentCompany Then "No Company Open" Else $$CurrentCompany

;; ============================================================================
;;  SYSTEM VARIABLES & PERSISTENT STORAGE
;; ============================================================================

[System: Variables]
    JBTWebSyncActive     : Yes
    JBTAutoStartProxy    : Yes
    JBTProxyPort         : 3001
    JBTTallyPort         : 9000
    JBTWebPortalURL      : "http://localhost:3000"
    JBTTDLFolderPath     : ""
    JBTProxyFolderPath   : ""

[Variable: JBTWebSyncActive]
    Type       : Logical
    Persistent : Yes
    Default    : Yes

[Variable: JBTAutoStartProxy]
    Type       : Logical
    Persistent : Yes
    Default    : Yes

[Variable: JBTProxyPort]
    Type       : Number
    Persistent : Yes
    Default    : 3001

[Variable: JBTTallyPort]
    Type       : Number
    Persistent : Yes
    Default    : 9000

[Variable: JBTWebPortalURL]
    Type       : String
    Persistent : Yes
    Default    : "http://localhost:3000"

[Variable: JBTTDLFolderPath]
    Type       : String
    Persistent : Yes
    Default    : "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-tdl"

[Variable: JBTProxyFolderPath]
    Type       : String
    Persistent : Yes
    Default    : "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-proxy"

;; ============================================================================
;;  GATEWAY OF TALLY - MENU & BUTTON INTEGRATION
;; ============================================================================

[#Menu: Gateway of Tally]
    Add : Key Item : @@JBTMenuTitle : W : Alter : JBTWebSyncReport
    Add : Button   : JBTQuickSyncToggleBtn

[Button: JBTQuickSyncToggleBtn]
    Title  : @@JBTButtonTitle
    Key    : Alt + W
    Action : Call : JBTToggleSyncFunction

;; ============================================================================
;;  SYSTEM EVENTS (Auto-Connect on Launch & Company Load)
;; ============================================================================

[System: Events]
    JBTAppStartEvent   : System Start : TRUE : CALL : JBTAutoStartOnLaunchFunction
    JBTCompanyLoadEvent: Load Company  : TRUE : CALL : JBTOnCompanyLoadFunction

[Function: JBTAutoStartOnLaunchFunction]
    001 : If : ##JBTWebSyncActive AND ##JBTAutoStartProxy AND NOT $$IsEmpty:##JBTTDLFolderPath
    002 :     Exec Command : "wscript.exe" : @@JBTLaunchCommand
    003 : End If
    004 : Return

[Function: JBTOnCompanyLoadFunction]
    001 : If : ##JBTWebSyncActive AND ##JBTAutoStartProxy AND NOT $$IsEmpty:##JBTTDLFolderPath
    002 :     Exec Command : "wscript.exe" : @@JBTLaunchCommand
    003 : End If
    004 : Return

;; ============================================================================
;;  INTERACTIVE FUNCTIONS (Toggle, Start Proxy, Stop Proxy)
;; ============================================================================

[Function: JBTToggleSyncFunction]
    001 : Set : JBTWebSyncActive : NOT ##JBTWebSyncActive
    002 : If : ##JBTWebSyncActive
    003 :     MsgBox : "Web Reporting Connector" : "Web Reporting Sync is now ENABLED."
    004 :     If : ##JBTAutoStartProxy AND NOT $$IsEmpty:##JBTTDLFolderPath
    005 :         Exec Command : "wscript.exe" : @@JBTLaunchCommand
    006 :     End If
    007 : Else
    008 :     MsgBox : "Web Reporting Connector" : "Web Reporting Sync is now DISABLED."
    009 : End If
    010 : Return

[Function: JBTManualStartProxyFunction]
    001 : If : $$IsEmpty:##JBTTDLFolderPath
    002 :     MsgBox : "Configuration Required" : "TDL Folder Path is not set! Please press W on Gateway of Tally and enter your folder path."
    003 :     Return
    004 : End If
    005 : Exec Command : "wscript.exe" : @@JBTLaunchCommand
    006 : MsgBox : "Web Reporting Connector" : "Tally Proxy Server starting on port 3001..."
    007 : Return

[Function: JBTManualStopProxyFunction]
    001 : If : $$IsEmpty:##JBTTDLFolderPath
    002 :     MsgBox : "Configuration Required" : "TDL Folder Path is not set! Please press W on Gateway of Tally and enter your folder path."
    003 :     Return
    004 : End If
    005 : Exec Command : "cmd.exe" : '"/c ' + @@JBTStopScript + '"'
    006 : MsgBox : "Web Reporting Connector" : "Tally Proxy Server has been stopped."
    007 : Return

;; ============================================================================
;;  REPORT & FORM: Configuration Screen
;; ============================================================================

[Report: JBTWebSyncReport]
    Title    : "Jay Baudhimai - Web Reporting Connector Configuration"
    Form     : JBTWebSyncForm
    Variable : JBTTDLFolderPath, JBTProxyFolderPath, JBTWebSyncActive, JBTAutoStartProxy, JBTWebPortalURL
    Auto     : Yes

[Form: JBTWebSyncForm]
    Part       : JBTWebSyncMainPart
    Button     : JBTOpenWebPortalBtn, JBTStartProxyBtn, JBTStopProxyBtn, JBTToggleSyncBtn
    Width      : 80% Screen
    Height     : 80% Screen

[Part: JBTWebSyncMainPart]
    Border: Thin Box
    Lines : JBTHeaderLine, JBTDivider1Line, +
            JBTPathSecTitleLine, JBTPathInputLine, JBTProxyPathLine, JBTPathHintLine, JBTDivider2Line, +
            JBTConnSecTitleLine, JBTCompanyLine, JBTSyncStatusLine, JBTPortsLine, JBTDivider3Line, +
            JBTConfigSecTitleLine, JBTToggleSyncLine, JBTAutoStartLine, JBTUrlLine, JBTDivider4Line, +
            JBTHelpKeysLine, JBTHelpSaveLine
    Scroll : Vertical

;; ----------------------------------------------------------------------------
;; 1. HEADER
;; ----------------------------------------------------------------------------

[Line: JBTHeaderLine]
    Fields       : JBTHeaderTitleFld, JBTHeaderVerFld
    Space Top    : 1
    Space Bottom : 1

[Field: JBTHeaderTitleFld]
    Use    : Simple Field
    Set As : "JAY BAUDHIMAI TRADERS - WEB REPORTING CONNECTOR"
    Style  : Large Bold
    Width  : 65
    Skip   : Yes

[Field: JBTHeaderVerFld]
    Use    : Simple Field
    Set As : "v2.2 Portable"
    Style  : Normal Bold
    Width  : 15
    Align  : Right
    Skip   : Yes

;; ----------------------------------------------------------------------------
;; DIVIDER LINES
;; ----------------------------------------------------------------------------

[Line: JBTDivider1Line]
    Fields : JBTDivider1Fld

[Field: JBTDivider1Fld]
    Use    : Simple Field
    Set As : "----------------------------------------------------------------------------------"
    Style  : Normal
    Width  : 82
    Skip   : Yes

[Line: JBTDivider2Line]
    Fields : JBTDivider2Fld

[Field: JBTDivider2Fld]
    Use    : Simple Field
    Set As : "----------------------------------------------------------------------------------"
    Style  : Normal
    Width  : 82
    Skip   : Yes

[Line: JBTDivider3Line]
    Fields : JBTDivider3Fld

[Field: JBTDivider3Fld]
    Use    : Simple Field
    Set As : "----------------------------------------------------------------------------------"
    Style  : Normal
    Width  : 82
    Skip   : Yes

[Line: JBTDivider4Line]
    Fields : JBTDivider4Fld

[Field: JBTDivider4Fld]
    Use    : Simple Field
    Set As : "----------------------------------------------------------------------------------"
    Style  : Normal
    Width  : 82
    Skip   : Yes

;; ----------------------------------------------------------------------------
;; 2. FOLDER PATH CONFIGURATION (TDL Path + Proxy Path)
;; ----------------------------------------------------------------------------

[Line: JBTPathSecTitleLine]
    Fields    : JBTPathSecTitleFld
    Space Top : 1

[Field: JBTPathSecTitleFld]
    Use    : Simple Field
    Set As : "[ 1. FOLDER PATH CONFIGURATION ]"
    Style  : Normal Bold
    Width  : 80
    Skip   : Yes

[Line: JBTPathInputLine]
    Fields    : JBTPathInputPrompt, JBTPathInputField
    Space Top : 1

[Field: JBTPathInputPrompt]
    Use    : Simple Field
    Set As : "TDL Folder Path :"
    Style  : Normal Bold
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTPathInputField]
    Use        : Short Name Field
    Set As     : If $$IsEmpty:##JBTTDLFolderPath Then "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-tdl" Else ##JBTTDLFolderPath
    Modifies   : JBTTDLFolderPath : Yes
    Border     : Thin Box
    Style      : Normal Bold
    Width      : 56
    Space Left : 2

[Line: JBTProxyPathLine]
    Fields    : JBTProxyPathPrompt, JBTProxyPathField
    Space Top : 1

[Field: JBTProxyPathPrompt]
    Use    : Simple Field
    Set As : "Proxy Folder Path :"
    Style  : Normal Bold
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTProxyPathField]
    Use        : Short Name Field
    Set As     : If $$IsEmpty:##JBTProxyFolderPath Then "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-proxy" Else ##JBTProxyFolderPath
    Modifies   : JBTProxyFolderPath : Yes
    Border     : Thin Box
    Style      : Normal Bold
    Width      : 56
    Space Left : 2

[Line: JBTPathHintLine]
    Fields       : JBTPathHintFld
    Space Bottom : 1

[Field: JBTPathHintFld]
    Use    : Simple Field
    Set As : "  --> TDL folder me scripts hoti hain aur Proxy folder me server.js hota hai"
    Style  : Normal Italic
    Width  : 80
    Skip   : Yes

;; ----------------------------------------------------------------------------
;; 3. CURRENT CONNECTION STATUS
;; ----------------------------------------------------------------------------

[Line: JBTConnSecTitleLine]
    Fields    : JBTConnSecTitleFld
    Space Top : 1

[Field: JBTConnSecTitleFld]
    Use    : Simple Field
    Set As : "[ 2. CURRENT STATUS ]"
    Style  : Normal Bold
    Width  : 80
    Skip   : Yes

[Line: JBTCompanyLine]
    Fields    : JBTCompanyPrompt, JBTCompanyVal
    Space Top : 1

[Field: JBTCompanyPrompt]
    Use    : Simple Field
    Set As : "Active Company :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTCompanyVal]
    Use        : Simple Field
    Set As     : @@JBTCompanyText
    Style      : Normal Bold
    Width      : 56
    Space Left : 2
    Skip   : Yes

[Line: JBTSyncStatusLine]
    Fields : JBTSyncStatusPrompt, JBTSyncStatusVal

[Field: JBTSyncStatusPrompt]
    Use    : Simple Field
    Set As : "Sync Service :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTSyncStatusVal]
    Use        : Simple Field
    Set As     : @@JBTSyncStatusText
    Style      : Normal Bold
    Width      : 56
    Space Left : 2
    Skip   : Yes

[Line: JBTPortsLine]
    Fields       : JBTPortsPrompt, JBTPortsVal
    Space Bottom : 1

[Field: JBTPortsPrompt]
    Use    : Simple Field
    Set As : "Configured Ports :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTPortsVal]
    Use        : Simple Field
    Set As     : "Tally HTTP Port: 9000   |   Proxy Port: 3001"
    Style      : Normal
    Width      : 56
    Space Left : 2
    Skip   : Yes

;; ----------------------------------------------------------------------------
;; 4. CONNECTOR PREFERENCES
;; ----------------------------------------------------------------------------

[Line: JBTConfigSecTitleLine]
    Fields    : JBTConfigSecTitleFld
    Space Top : 1

[Field: JBTConfigSecTitleFld]
    Use    : Simple Field
    Set As : "[ 3. CONNECTOR PREFERENCES ]"
    Style  : Normal Bold
    Width  : 80
    Skip   : Yes

[Line: JBTToggleSyncLine]
    Fields    : JBTToggleSyncPrompt, JBTToggleSyncField
    Space Top : 1

[Field: JBTToggleSyncPrompt]
    Use    : Simple Field
    Set As : "Enable Web Sync :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTToggleSyncField]
    Use        : Logical Field
    Set As     : ##JBTWebSyncActive
    Modifies   : JBTWebSyncActive : Yes
    Border     : Thin Box
    Width      : 10
    Space Left : 2

[Line: JBTAutoStartLine]
    Fields : JBTAutoStartPrompt, JBTAutoStartField

[Field: JBTAutoStartPrompt]
    Use    : Simple Field
    Set As : "Auto-Start Proxy :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTAutoStartField]
    Use        : Logical Field
    Set As     : ##JBTAutoStartProxy
    Modifies   : JBTAutoStartProxy : Yes
    Border     : Thin Box
    Width      : 10
    Space Left : 2

[Line: JBTUrlLine]
    Fields       : JBTUrlPrompt, JBTUrlField
    Space Bottom : 1

[Field: JBTUrlPrompt]
    Use    : Simple Field
    Set As : "Web Portal URL :"
    Style  : Normal
    Width  : 24
    Align  : Right
    Skip   : Yes

[Field: JBTUrlField]
    Use        : Short Name Field
    Set As     : ##JBTWebPortalURL
    Modifies   : JBTWebPortalURL : Yes
    Border     : Thin Box
    Width      : 56
    Space Left : 2

;; ----------------------------------------------------------------------------
;; 5. HELP & ACTIONS
;; ----------------------------------------------------------------------------

[Line: JBTHelpKeysLine]
    Fields    : JBTHelpKeysFld
    Space Top : 1

[Field: JBTHelpKeysFld]
    Use    : Simple Field
    Set As : "Quick Buttons: [F4] Open Portal  [F5] Start Proxy  [F6] Stop Proxy  [Alt+W] Toggle"
    Style  : Normal Bold
    Width  : 80
    Skip   : Yes

[Line: JBTHelpSaveLine]
    Fields       : JBTHelpSaveFld
    Space Bottom : 1

[Field: JBTHelpSaveFld]
    Use    : Simple Field
    Set As : "Press Enter through fields to save, or press Ctrl+A to save immediately."
    Style  : Normal Italic
    Width  : 80
    Skip   : Yes

;; ============================================================================
;;  ACTION BUTTONS (Right-side button bar)
;; ============================================================================

[Button: JBTOpenWebPortalBtn]
    Title  : "F4: Open Web Portal"
    Key    : F4
    Action : Browse URL : ##JBTWebPortalURL

[Button: JBTStartProxyBtn]
    Title  : "F5: Start Proxy"
    Key    : F5
    Action : Call : JBTManualStartProxyFunction

[Button: JBTStopProxyBtn]
    Title  : "F6: Stop Proxy"
    Key    : F6
    Action : Call : JBTManualStopProxyFunction

[Button: JBTToggleSyncBtn]
    Title  : "Alt+T: Toggle Sync"
    Key    : Alt + T
    Action : Call : JBTToggleSyncFunction

;; ============================================================================
;;  TDL COLLECTION FOR WEB APP STATUS QUERY
;; ============================================================================

[Collection: JBTWebSyncInfo]
    Type     : Company
    Fetch    : Name
    Computed : IsWebSyncEnabled : If ##JBTWebSyncActive Then "Yes" Else "No"
    Computed : AutoStartProxy   : If ##JBTAutoStartProxy Then "Yes" Else "No"
    Computed : ProxyPort        : $$String:##JBTProxyPort
    Computed : TallyPort        : $$String:##JBTTallyPort
    Computed : PortalURL        : ##JBTWebPortalURL
    Computed : TDLFolderPath    : ##JBTTDLFolderPath
    Computed : ProxyFolderPath  : ##JBTProxyFolderPath
