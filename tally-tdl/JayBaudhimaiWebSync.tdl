;; ============================================================================
;;  JAY BAUDHIMAI TRADERS — WEB REPORTING & LIVE SYNC CONNECTOR
;;  TallyPrime TDL Module
;;
;;  Features:
;;  1. Auto-Start Proxy & Auto-Connect when Tally starts up.
;;  2. In-Tally ON / OFF Toggle Switch from Gateway of Tally (Alt + W).
;;  3. Persistent configuration saved across Tally sessions.
;;  4. One-click F4 button to launch Web Portal directly in default browser.
;;  5. TDL Collection JBTWebSyncInfo for Web App bi-directional status sync.
;; ============================================================================

[#System: Formulae]
    JBTAddonName         : "Jay Baudhimai Web Sync"
    JBTAddonVersion      : "1.0.0"
    JBTDefaultProxyPort  : 3001
    JBTDefaultTallyPort  : 9000
    JBTDefaultPortalURL  : "http://localhost:3000"
    JBTLauncherScript    : "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-tdl\\start-proxy-silent.vbs"
    JBTStopScript        : "C:\\Users\\dell\\Documents\\GitHub\\TALLY_REPORTING\\tally-tdl\\stop-proxy.bat"
    JBTMenuTitle         : If ##JBTWebSyncActive Then "Web Reporting Connector [ON]" Else "Web Reporting Connector [OFF]"

;; ────────────────────────────────────────────────────────────────────────────
;;  SYSTEM VARIABLES & PERSISTENT STORAGE
;; ────────────────────────────────────────────────────────────────────────────

[System: Variables]
    JBTWebSyncActive     : Yes
    JBTAutoStartProxy    : Yes
    JBTProxyPort         : 3001
    JBTTallyPort         : 9000
    JBTWebPortalURL      : "http://localhost:3000"

[Variable: JBTWebSyncActive]
    Type       : Logical
    Persistent : Yes
    Default    : Yes

[Variable: JBTAutoStartProxy]
    Type       : Logical
    Persistent : Yes
    Default    : Yes

[Variable: JBTProxyPort]
    Type       : Number
    Persistent : Yes
    Default    : 3001

[Variable: JBTTallyPort]
    Type       : Number
    Persistent : Yes
    Default    : 9000

[Variable: JBTWebPortalURL]
    Type       : String
    Persistent : Yes
    Default    : "http://localhost:3000"

;; ────────────────────────────────────────────────────────────────────────────
;;  GATEWAY OF TALLY MENU & BUTTON INTEGRATION
;; ────────────────────────────────────────────────────────────────────────────

[#Menu: Gateway of Tally]
    ;; Add dedicated menu option under Utilities / Custom
    Add : Key Item : @@JBTMenuTitle : W : Display : JBTWebSyncReport
    ;; Add quick toggle button to the right button bar
    Add : Button   : JBTQuickSyncToggleBtn

[Button: JBTQuickSyncToggleBtn]
    Title  : If ##JBTWebSyncActive Then "● Web Sync: ON" Else "○ Web Sync: OFF"
    Key    : Alt + W
    Action : Call : JBTToggleSyncFunction

;; ────────────────────────────────────────────────────────────────────────────
;;  SYSTEM EVENTS (Auto-Connect on Tally Launch & Company Load)
;; ────────────────────────────────────────────────────────────────────────────

[System: Events]
    JBTAppStartEvent   : System Start : TRUE : CALL : JBTAutoStartOnLaunchFunction
    JBTCompanyLoadEvent: Load Company  : TRUE : CALL : JBTOnCompanyLoadFunction

[Function: JBTAutoStartOnLaunchFunction]
    001 : If : ##JBTWebSyncActive AND ##JBTAutoStartProxy
    002 :     Exec Command : "wscript.exe" : '"' + @@JBTLauncherScript + '"'
    003 : End If
    004 : Return

[Function: JBTOnCompanyLoadFunction]
    001 : If : ##JBTWebSyncActive AND ##JBTAutoStartProxy
    002 :     Exec Command : "wscript.exe" : '"' + @@JBTLauncherScript + '"'
    003 : End If
    004 : Return

;; ────────────────────────────────────────────────────────────────────────────
;;  INTERACTIVE FUNCTIONS (Toggle ON/OFF, Launch Proxy, Open Web)
;; ────────────────────────────────────────────────────────────────────────────

[Function: JBTToggleSyncFunction]
    001 : Set : JBTWebSyncActive : NOT ##JBTWebSyncActive
    002 : If : ##JBTWebSyncActive
    003 :     MsgBox : "Web Reporting Connector" : "Web Reporting Sync has been ENABLED."
    004 :     If : ##JBTAutoStartProxy
    005 :         Exec Command : "wscript.exe" : '"' + @@JBTLauncherScript + '"'
    006 :     End If
    007 : Else
    008 :     MsgBox : "Web Reporting Connector" : "Web Reporting Sync has been DISABLED."
    009 : End If
    010 : Return

[Function: JBTManualStartProxyFunction]
    001 : Exec Command : "wscript.exe" : '"' + @@JBTLauncherScript + '"'
    002 : MsgBox : "Web Reporting Connector" : "Starting Tally Proxy Server on port 3001..."
    003 : Return

[Function: JBTManualStopProxyFunction]
    001 : Exec Command : "cmd.exe" : '"/c ' + @@JBTStopScript + '"'
    002 : MsgBox : "Web Reporting Connector" : "Tally Proxy Server has been stopped."
    003 : Return

;; ────────────────────────────────────────────────────────────────────────────
;;  REPORT & FORM: Web Reporting Connector Configuration
;; ────────────────────────────────────────────────────────────────────────────

[Report: JBTWebSyncReport]
    Title       : "Jay Baudhimai - Web Reporting Connector"
    Form        : JBTWebSyncForm

[Form: JBTWebSyncForm]
    Parts       : JBTHeaderPart, JBTStatusPart, JBTConfigPart, JBTActionHelpPart
    Button      : JBTOpenWebPortalBtn, JBTStartProxyBtn, JBTStopProxyBtn, JBTToggleSyncBtn
    Width       : 75% Page
    Height      : 70% Page
    Background  : White

;; --- 1. Header Part ---
[Part: JBTHeaderPart]
    Lines       : JBTHeaderLine
    Space Top   : 1
    Space Bottom: 1
    Border      : Thin Bottom

[Line: JBTHeaderLine]
    Fields      : JBTHeaderTitleField, JBTHeaderVerField

[Field: JBTHeaderTitleField]
    Use         : Simple Field
    Set As      : "JAY BAUDHIMAI TRADERS — WEB REPORTING CONNECTOR"
    Style       : Large Bold
    Color       : Royal Blue
    Width       : 80%

[Field: JBTHeaderVerField]
    Use         : Simple Field
    Set As      : "v1.0.0"
    Style       : Normal Bold
    Color       : Dim Grey
    Width       : 20%
    Align       : Right

;; --- 2. Live Status Part ---
[Part: JBTStatusPart]
    Lines       : JBTStatusHeadingLine, JBTStatusCompanyLine, JBTStatusStateLine, JBTStatusPortsLine
    Space Top   : 1
    Space Bottom: 1

[Line: JBTStatusHeadingLine]
    Fields      : JBTSectionHeadingField
    Local : Field : JBTSectionHeadingField : Set As : "Current Connectivity Status"

[Line: JBTStatusCompanyLine]
    Fields      : JBTLabelField, JBTValueField
    Local : Field : JBTLabelField : Set As : "Active Company :"
    Local : Field : JBTValueField : Set As : If $$IsEmpty:$$CurrentCompany Then "No Company Open" Else $$CurrentCompany
    Local : Field : JBTValueField : Style  : Normal Bold

[Line: JBTStatusStateLine]
    Fields      : JBTLabelField, JBTStatusValField
    Local : Field : JBTLabelField : Set As : "Web Sync Status :"

[Field: JBTStatusValField]
    Use         : Simple Field
    Set As      : If ##JBTWebSyncActive Then "● ENABLED & ACTIVE" Else "○ DISABLED / PAUSED"
    Style       : Large Bold
    Color       : If ##JBTWebSyncActive Then "Dark Green" Else "Deep Pink"
    Width       : 40%

[Line: JBTStatusPortsLine]
    Fields      : JBTLabelField, JBTValueField
    Local : Field : JBTLabelField : Set As : "Ports Configured :"
    Local : Field : JBTValueField : Set As : "Tally HTTP: " + $$String:##JBTTallyPort + "  |  Proxy: " + $$String:##JBTProxyPort

;; --- 3. Configuration & Toggle Part ---
[Part: JBTConfigPart]
    Lines       : JBTConfigHeadingLine, JBTConfigToggleLine, JBTConfigAutoStartLine, JBTConfigUrlLine
    Border      : Thin Top
    Space Top   : 1
    Space Bottom: 1

[Line: JBTConfigHeadingLine]
    Fields      : JBTSectionHeadingField
    Local : Field : JBTSectionHeadingField : Set As : "Connector Settings (Press Space to Change)"

[Line: JBTConfigToggleLine]
    Fields      : JBTLabelField, JBTConfigToggleField
    Local : Field : JBTLabelField : Set As : "Enable Web Sync :"

[Field: JBTConfigToggleField]
    Use         : Logical Field
    Modifies    : JBTWebSyncActive
    Width       : 15%

[Line: JBTConfigAutoStartLine]
    Fields      : JBTLabelField, JBTConfigAutoStartField
    Local : Field : JBTLabelField : Set As : "Auto-Start Proxy on Tally Open :"

[Field: JBTConfigAutoStartField]
    Use         : Logical Field
    Modifies    : JBTAutoStartProxy
    Width       : 15%

[Line: JBTConfigUrlLine]
    Fields      : JBTLabelField, JBTConfigUrlField
    Local : Field : JBTLabelField : Set As : "Web Portal URL :"

[Field: JBTConfigUrlField]
    Use         : Name Field
    Modifies    : JBTWebPortalURL
    Width       : 45%

;; --- 4. Action Help Part ---
[Part: JBTActionHelpPart]
    Lines       : JBTHelpLine1, JBTHelpLine2
    Border      : Thin Top
    Space Top   : 1

[Line: JBTHelpLine1]
    Fields      : JBTHelpField
    Local : Field : JBTHelpField : Set As : "Quick Actions:  [F4] Open Web Portal  |  [F5] Start Proxy  |  [F6] Stop Proxy  |  [Alt+W] Toggle ON/OFF"
    Local : Field : JBTHelpField : Style  : Normal Bold
    Local : Field : JBTHelpField : Color  : Blue

[Line: JBTHelpLine2]
    Fields      : JBTHelpField
    Local : Field : JBTHelpField : Set As : "Press Enter to save preferences. Preferences are remembered automatically across Tally restarts."
    Local : Field : JBTHelpField : Style  : Italic
    Local : Field : JBTHelpField : Color  : Grey

;; --- Reusable Styles and Base Fields ---
[Field: JBTSectionHeadingField]
    Use         : Simple Field
    Style       : Normal Bold
    Color       : Royal Blue
    Width       : 100%

[Field: JBTLabelField]
    Use         : Simple Field
    Width       : 30%
    Color       : Dim Grey

[Field: JBTValueField]
    Use         : Simple Field
    Width       : 70%

[Field: JBTHelpField]
    Use         : Simple Field
    Width       : 100%

;; ────────────────────────────────────────────────────────────────────────────
;;  ACTION BUTTONS
;; ────────────────────────────────────────────────────────────────────────────

[Button: JBTOpenWebPortalBtn]
    Title       : "F4: Open Web Portal"
    Key         : F4
    Action      : Browse URL : ##JBTWebPortalURL

[Button: JBTStartProxyBtn]
    Title       : "F5: Start Proxy"
    Key         : F5
    Action      : Call : JBTManualStartProxyFunction

[Button: JBTStopProxyBtn]
    Title       : "F6: Stop Proxy"
    Key         : F6
    Action      : Call : JBTManualStopProxyFunction

[Button: JBTToggleSyncBtn]
    Title       : "Alt+T: Toggle Sync"
    Key         : Alt + T
    Action      : Call : JBTToggleSyncFunction

;; ────────────────────────────────────────────────────────────────────────────
;;  TDL COLLECTION FOR WEB APP STATUS QUERY
;; ────────────────────────────────────────────────────────────────────────────

[Collection: JBTWebSyncInfo]
    Type        : Company
    Fetch       : Name
    Computed    : IsWebSyncEnabled : If ##JBTWebSyncActive Then "Yes" Else "No"
    Computed    : AutoStartProxy   : If ##JBTAutoStartProxy Then "Yes" Else "No"
    Computed    : ProxyPort        : $$String:##JBTProxyPort
    Computed    : TallyPort        : $$String:##JBTTallyPort
    Computed    : PortalURL        : ##JBTWebPortalURL
